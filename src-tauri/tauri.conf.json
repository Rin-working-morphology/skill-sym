{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SkillSym",
  "version": "0.1.3",
  "identifier": "com.rin.skillsym",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SkillSym",
        "width": 800,
        "height": 600,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzNTBCMTMzMUY1N0I1MTEKUldRUnRWY2ZNN0ZRazNNTkpNV2ZiSEIwOGx3MFAxaVpONWxjSkZqN0ZCeDBMSktNOGltZG5HZzcK",
      "endpoints": [
        "https://github.com/Rin-working-morphology/skill-sym/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
